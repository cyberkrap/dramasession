FROM python:3.11-slim-bookworm

ARG DENO_VERSION=2.5.6
ARG BGUTIL_VERSION=1.3.1

ENV PYTHONUNBUFFERED=1 \
	PYTHONDONTWRITEBYTECODE=1 \
	PIP_NO_CACHE_DIR=1

RUN apt-get update \
	&& apt-get install -y --no-install-recommends \
		build-essential curl ffmpeg gettext-base git imagemagick libjpeg62-turbo-dev libpq-dev unzip \
		libwebp-dev nginx supervisor zlib1g-dev \
	&& rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://deno.land/install.sh | sh -s v${DENO_VERSION} \
	&& install -m 0755 /root/.deno/bin/deno /usr/local/bin/deno \
	&& rm -rf /root/.deno \
	&& deno --version

RUN git clone --depth 1 --branch ${BGUTIL_VERSION} \
		https://github.com/Brainicism/bgutil-ytdlp-pot-provider.git \
		/root/bgutil-ytdlp-pot-provider \
	&& cd /root/bgutil-ytdlp-pot-provider/server \
	&& deno install --allow-scripts=npm:canvas --frozen

WORKDIR /app
COPY requirements.txt /app/requirements.txt
RUN pip install -r /app/requirements.txt
COPY . /app

RUN mkdir -p /data /app/files/assets/images/Obsession/defaults \
	/app/files/assets/images/Obsession/banners \
	/app/files/assets/images/Obsession/sidebar \
	/app/files/assets/images/emojis /app/files/assets/images/hats \
	/app/asset_submissions \
	&& chmod +x /app/railway-entrypoint.sh

EXPOSE 8080
ENTRYPOINT ["/app/railway-entrypoint.sh"]