{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "the-obsession-club",
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "triggers": {
    "onPostSubmit": "/internal/triggers/on-post-submit",
    "onPostDelete": "/internal/triggers/on-post-delete"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "permissions": {
    "http": {
      "enable": true,
      "domains": [
        "theobsessionclub.com"
      ]
    }
  },
  "settings": {
    "subreddit": {
      "toc_webhook_secret": {
        "type": "string",
        "label": "TOC webhook secret",
        "helpText": "Shared HMAC secret used to authenticate Snatchy requests to The Obsession Club."
      },
      "enabled": {
        "type": "boolean",
        "label": "Enable Snatchy imports",
        "defaultValue": true
      }
    }
  }
}
