{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "snatchy-toc",
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "triggers": {
    "onPostSubmit": "/internal/triggers/on-post-submit",
    "onPostDelete": "/internal/triggers/on-post-delete"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "permissions": {
    "http": {
      "enable": true,
      "domains": [
        "theobsessionclub.com"
      ]
    },
    "redis": true
  }
}
